# Copia este archivo a .env y rellena SOLO el proveedor que vayas a usar. .env no se sube a git.
PROVIDER=elevenlabs
NAME=Elsa

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_CA=
# ELEVENLABS_MODEL=eleven_multilingual_v2   # comprueba qué modelo soporta catalán ahora mismo
# ELEVENLABS_SPEED=0.9
# ELEVENLABS_SEND_LANGUAGE=1

# --- Azure AI Speech ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE_ES=es-ES-ElviraNeural
# AZURE_VOICE_CA=ca-ES-JoanaNeural
# AZURE_RATE=-10%

# --- Google Cloud TTS ---
# GOOGLE_TTS_API_KEY=
# GOOGLE_VOICE_ES=es-ES-Neural2-A
# GOOGLE_VOICE_CA=ca-ES-Standard-A

# --- Piper (local, gratis) ---
# PIPER_MODEL_ES=/ruta/a/es_ES-modelo.onnx
# PIPER_MODEL_CA=/ruta/a/ca_ES-modelo.onnx

# --- Edge TTS (gratis, sin cuenta, no oficial) ---
# EDGE_VOICE_ES=es-ES-ElviraNeural
# EDGE_VOICE_CA=ca-ES-JoanaNeural
# EDGE_RATE=-10%
